# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Scraped data (can be large; regenerate via the scraper). Keep dir structure.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# ...but DO persist the cleaned kworb chart masters (CSV only) so the daily
# GitHub Action can accumulate history across runs and the live site has data.
# Parquet is kept local to avoid binary churn; CSV is the source of truth in git.
!data/processed/kworb_global_daily.csv
!data/processed/kworb_songs.csv
!data/processed/kworb_artists.csv
!data/processed/kworb_scrape_summary.json

# Logs
logs/*
!logs/.gitkeep

# Secrets / sessions — NEVER commit your Spotify auth, cookies, or tokens
playwright_state.json
.env
.env.*
!.env.example
*.cookies
*.token
cookies.txt

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Generated static data for the frontend (regenerate with generate_frontend_data.py)
frontend/public/data/*
!frontend/public/data/.gitkeep
