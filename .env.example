# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in YOUR OWN values.
# NEVER commit a real .env — it is gitignored. These are read only by the
# Python scrapers (backend); they are NEVER bundled into the frontend.
# ---------------------------------------------------------------------------

# --- charts.spotify.com auth (scripts/scrape_spotify_global_200.py) ---------
# Use credentials for an account you are entitled to use. Do not bypass auth.
SPOTIFY_CHARTS_BEARER=
SPOTIFY_SP_DC=
# Advanced: full raw Cookie header instead of just sp_dc
SPOTIFY_CHARTS_COOKIE=
# Override the (undocumented) authenticated CSV download URL if it changes.
# SPOTIFY_CHARTS_DOWNLOAD_URL=https://charts.spotify.com/api/v2/charts/regional-global-daily/{date}/download

# Path where the Playwright login session is stored (gitignored).
SPOTIFY_PLAYWRIGHT_STATE=playwright_state.json

# --- kworb.net scraper (scripts/scrape_kworb.py) ----------------------------
# No auth required — kworb is public. Nothing to set here.

# --- Frontend ---------------------------------------------------------------
# The frontend reads only static JSON in frontend/public/data and needs NO
# secrets. If deploying under a sub-path you can set a custom Vite base at
# build time, e.g. VITE base is configured in vite.config.ts (defaults to './').
